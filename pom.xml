<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://maven.apache.org/POM/4.0.0"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>obeo</groupId>
	<artifactId>emf-generator-container</artifactId>
	<version>2026.10.0</version>

	<name>EMF Generator</name>
	<description>Sirius Web EMF code generator</description>
	<packaging>pom</packaging>

	<distributionManagement>
		<repository>
			<id>github-emf-generator</id>
			<name>Sirius Web EMF Generator</name>
			<url>https://maven.pkg.github.com/eclipse-sirius/sirius-web-emf-generator</url>
		</repository>
	</distributionManagement>

	<modules>
		<module>emf-generator</module>
	</modules>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>versions-maven-plugin</artifactId>
					<configuration>
						<processAllModules>true</processAllModules>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
